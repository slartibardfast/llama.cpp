#version 450

// GET_ROWS: extract and dequantize specific rows from TURBO_KV_4B buffer.
// Output type: D_TYPE (float16_t or float, selected by define).

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require

#include "types.glsl"
#include "turbo_kv_4b_rht.glsl"

layout (push_constant) uniform parameter {
    uint ne00; uint nb01; uint nb02;
    uint ne10; uint ne11; uint ne12;
    uint ne0; uint nb1; uint nb2;
} p;

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly buffer A {block_turbo_kv_4b data_a[];};
layout (binding = 1) readonly buffer B {int data_b[];};
layout (binding = 2) writeonly buffer D {D_TYPE data_d[];};

void main() {
    const uint row_idx = gl_WorkGroupID.y;
    const uint blk_in_row = gl_WorkGroupID.x;
    const uint tid = gl_SubgroupInvocationID;

    const uint src_row = uint(data_b[row_idx]);
    const uint src_blk = src_row * (p.ne00 / QUANT_K_TURBO_KV_4B) + blk_in_row;

    const float norm = unpackHalf2x16(uint(data_a[src_blk].norm)).x;
    const float inv_std = unpackHalf2x16(uint(data_a[src_blk].inv_std_fp16)).x;
    const float rcp_inv_std = 1.0 / max(inv_std, 1e-10);

    float val0 = turbo_kv_unpack_byte(uint(data_a[src_blk].mse_indices[tid / 2]),      tid,      rcp_inv_std);
    float val1 = turbo_kv_unpack_byte(uint(data_a[src_blk].mse_indices[(tid + 64) / 2]), tid + 64, rcp_inv_std);

    turbo_kv_inverse_rht(val0, val1, tid, norm);

    const uint dst_base = row_idx * p.ne00 + blk_in_row * QUANT_K_TURBO_KV_4B;
    data_d[dst_base + tid]      = D_TYPE(val0);
    data_d[dst_base + tid + 64] = D_TYPE(val1);
}
