#version 450

#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require

#include "mul_mat_vec_base.glsl"

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

ACC_TYPE temp[NUM_COLS][NUM_ROWS];

void calc_superblock(const uint a_offset, const uint b_offset, const uint v_im, const uint l0, const uint q_offset, const uint y_offset, const uint i, const uint num_blocks_per_row, const uint first_row, const uint num_rows) {
    const uint y1_idx = i * QUANT_K + y_offset;
    const uint y2_idx = y1_idx + 128;

    [[unroll]] for (uint n = 0; n < num_rows; ++n) {
        const uint ib0 = a_offset + (first_row+n)*num_blocks_per_row;
        const FLOAT_TYPEV2 dm = FLOAT_TYPEV2(data_a[ib0 + i].dm);

        // qh persists across both phases (1 VGPR)
        const uint32_t qh = pack32(u16vec2(data_a_packed16[ib0 + i].qh[l0 / 2], data_a_packed16[ib0 + i].qh[l0 / 2 + 8]));

        // Precompute scale high bits — persists for phase 1 (1 VGPR)
        const uint32_t scale0_u32 = data_a_packed16[ib0 + i].scales[v_im    ];
        const uint32_t scale4_u32 = data_a_packed16[ib0 + i].scales[v_im + 2];
        const uint32_t scale_0_4_l = (scale4_u32 << 16) | scale0_u32;
        const uint32_t scale_0_4_h = (scale_0_4_l & 0xC0C0C0C0) >> 2;

        // === PHASE 0: sub-blocks 0,1 (y1_idx region) ===
        {
            const FLOAT_TYPEV4 sc = FLOAT_TYPEV4(vec4(unpack8(scale_0_4_l & 0x3F3F3F3F)));

            const uint32_t qs_u32 = uint32_t(data_a_packed16[ib0 + i].qs[q_offset / 2]) | (uint32_t(data_a_packed16[ib0 + i].qs[q_offset / 2 + 8]) << 16);
            uint32_t qs_lo4 = qs_u32 & 0x0F0F0F0F;
            uint32_t qs_hi4 = (qs_u32 >> 4) & 0x0F0F0F0F;
            qs_lo4 += ((qh >> (2*v_im)) & 0x01010101) << 4;
            qs_hi4 += ((qh >> (2*v_im)) & 0x02020202) << 3;
            const FLOAT_TYPEV4 q_lo = FLOAT_TYPEV4(vec4(unpack8(qs_lo4)));
            const FLOAT_TYPEV4 q_hi = FLOAT_TYPEV4(vec4(unpack8(qs_hi4)));

            [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
                const FLOAT_TYPEV2 b0 = FLOAT_TYPEV2(data_b_v2[(j*p.batch_stride_b + b_offset + y1_idx) / 2     ]);
                const FLOAT_TYPEV2 b1 = FLOAT_TYPEV2(data_b_v2[(j*p.batch_stride_b + b_offset + y1_idx) / 2 +  8]);
                const FLOAT_TYPEV2 b2 = FLOAT_TYPEV2(data_b_v2[(j*p.batch_stride_b + b_offset + y1_idx) / 2 + 16]);
                const FLOAT_TYPEV2 b3 = FLOAT_TYPEV2(data_b_v2[(j*p.batch_stride_b + b_offset + y1_idx) / 2 + 24]);

                const FLOAT_TYPE sx =
                    fma(b0.x, q_lo.x, fma(b0.y, q_lo.y, fma(b1.x, q_lo.z, b1.y * q_lo.w)));
                const FLOAT_TYPE sy =
                    fma(b2.x, q_hi.x, fma(b2.y, q_hi.y, fma(b3.x, q_hi.z, b3.y * q_hi.w)));
                const FLOAT_TYPE smin0 =
                    (b0.x + b0.y + b1.x + b1.y) * sc.z +
                    (b2.x + b2.y + b3.x + b3.y) * sc.w;

                temp[j][n] += ACC_TYPE(fma(dm.x, fma(sx, sc.x, sy * sc.y), -dm.y * smin0));
            }
        }

        // === PHASE 1: sub-blocks 2,3 (y2_idx region) ===
        {
            const uint32_t scale8_u32 = data_a_packed16[ib0 + i].scales[v_im + 4];
            const FLOAT_TYPEV4 sc = FLOAT_TYPEV4(vec4(unpack8((((scale8_u32 << 12) | scale8_u32) & 0x0F0F0F0F) | scale_0_4_h)));

            const uint32_t qs_u32 = uint32_t(data_a_packed16[ib0 + i].qs[q_offset / 2 + 32]) | (uint32_t(data_a_packed16[ib0 + i].qs[q_offset / 2 + 40]) << 16);
            uint32_t qs_lo4 = qs_u32 & 0x0F0F0F0F;
            uint32_t qs_hi4 = (qs_u32 >> 4) & 0x0F0F0F0F;
            qs_lo4 += ((qh >> (2*v_im)) & 0x10101010);
            qs_hi4 += ((qh >> (2*v_im)) & 0x20202020) >> 1;
            const FLOAT_TYPEV4 q_lo = FLOAT_TYPEV4(vec4(unpack8(qs_lo4)));
            const FLOAT_TYPEV4 q_hi = FLOAT_TYPEV4(vec4(unpack8(qs_hi4)));

            [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
                const FLOAT_TYPEV2 b0 = FLOAT_TYPEV2(data_b_v2[(j*p.batch_stride_b + b_offset + y2_idx) / 2     ]);
                const FLOAT_TYPEV2 b1 = FLOAT_TYPEV2(data_b_v2[(j*p.batch_stride_b + b_offset + y2_idx) / 2 +  8]);
                const FLOAT_TYPEV2 b2 = FLOAT_TYPEV2(data_b_v2[(j*p.batch_stride_b + b_offset + y2_idx) / 2 + 16]);
                const FLOAT_TYPEV2 b3 = FLOAT_TYPEV2(data_b_v2[(j*p.batch_stride_b + b_offset + y2_idx) / 2 + 24]);

                const FLOAT_TYPE sz =
                    fma(b0.x, q_lo.x, fma(b0.y, q_lo.y, fma(b1.x, q_lo.z, b1.y * q_lo.w)));
                const FLOAT_TYPE sw =
                    fma(b2.x, q_hi.x, fma(b2.y, q_hi.y, fma(b3.x, q_hi.z, b3.y * q_hi.w)));
                const FLOAT_TYPE smin1 =
                    (b0.x + b0.y + b1.x + b1.y) * sc.z +
                    (b2.x + b2.y + b3.x + b3.y) * sc.w;

                temp[j][n] += ACC_TYPE(fma(dm.x, fma(sz, sc.x, sw * sc.y), -dm.y * smin1));
            }
        }
    }
}

void compute_outputs(const uint32_t first_row, const uint32_t num_rows) {
    uint a_offset, b_offset, d_offset;
    get_offsets(a_offset, b_offset, d_offset);

    const uint num_blocks_per_row = p.ncols / QUANT_K;

    // 16 threads are used to process each block
    const uint it_size = gl_WorkGroupSize.x/16;
    const uint tid = gl_LocalInvocationID.x;
    const uint itid = tid%16;  // 0...15
    const uint ix = tid/16;

    const uint il = itid/4;                          // 0...3
    const uint ir = itid - 4*il;                     // 0...3

    const uint v_im = il / 2;  // 0 or 1. 0 computes 0,32 + 128,160, 1 computes 64,96 + 192,224
    const uint v_in = il % 2;

    const uint l0 = 4*ir + 2*v_in;                   // 0...15
    const uint q_offset = 32*v_im + l0;
    const uint y_offset = 64*v_im + l0;

    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        [[unroll]] for (uint i = 0; i < NUM_ROWS; ++i) {
            temp[j][i] = ACC_TYPE(0);
        }
    }

    [[unroll]] for (uint i = ix; i < num_blocks_per_row; i += it_size)
        calc_superblock(a_offset, b_offset, v_im, l0, q_offset, y_offset, i, num_blocks_per_row, first_row, num_rows);

    reduce_result(temp, d_offset, first_row, num_rows, tid);
}

void main() {
    const uint first_row = NUM_ROWS * (gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z);

    // do NUM_ROWS at a time, unless there aren't enough remaining rows
    if (first_row + NUM_ROWS <= p.stride_d) {
        compute_outputs(first_row, NUM_ROWS);
    } else {
        if (first_row >= p.stride_d) {
            return;
        }
        compute_outputs(first_row, p.stride_d - first_row);
    }
}
