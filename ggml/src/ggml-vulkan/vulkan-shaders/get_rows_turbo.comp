// get_rows_turbo.comp — Generic GET_ROWS for TURBO_*B weight types.
//
// Compile with: -DBITS=2|3|4|5 -DSUBGROUP_SIZE=32|64 -DD_TYPE=float16_t|float
// Mirrors dequant_turbo.comp algorithm; differs only in addressing:
//   src block selected by (row_idx tensor lookup × blocks_per_row + blk_in_row)
//   dst written into row_idx-th output row.

#version 450

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require

#define TURBO_CB_BINDING 3
#include "turbo_rht.glsl"

#define BLOCK_ELEMS 128
#define HEADER_BYTES 4
#define DATA_BYTES (BLOCK_ELEMS * BITS / 8)
#define BLOCK_BYTES (HEADER_BYTES + DATA_BYTES)

// vk_op_binary_push_constants layout (same as get_rows_turbo_kv_4b).
layout (push_constant) uniform parameter {
    uint ne;
    uint ne00; uint ne01; uint ne02; uint ne03;
    uint nb00; uint nb01; uint nb02; uint nb03;
    uint ne10; uint ne11; uint ne12; uint ne13;
    uint nb10; uint nb11; uint nb12; uint nb13;
    uint ne20; uint ne21; uint ne22; uint ne23;
    uint nb20; uint nb21; uint nb22; uint nb23;
    uint misalign_offsets;
    float param1; float param2; int param3;
} p;

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly buffer A { uint8_t data_a[]; };
layout (binding = 1) readonly buffer B { int data_b[]; };
layout (binding = 2) writeonly buffer D { D_TYPE data_d[]; };

void main() {
    const uint row_idx    = gl_WorkGroupID.y;
    const uint blk_in_row = gl_WorkGroupID.x;
    const uint tid        = gl_SubgroupInvocationID;

    const uint src_row = uint(data_b[row_idx]);
    const uint blocks_per_row = p.ne00 / BLOCK_ELEMS;
    const uint src_blk = src_row * blocks_per_row + blk_in_row;
    const uint block_offset = src_blk * BLOCK_BYTES;

    uint16_t norm_bits    = uint16_t(data_a[block_offset + 0]) | (uint16_t(data_a[block_offset + 1]) << 8);
    uint16_t inv_std_bits = uint16_t(data_a[block_offset + 2]) | (uint16_t(data_a[block_offset + 3]) << 8);
    float norm        = turbo_fp16_to_f32(norm_bits);
    float inv_std     = turbo_fp16_to_f32(inv_std_bits);
    float rcp_inv_std = 1.0 / max(inv_std, 1e-10);

    const uint qs_offset = block_offset + HEADER_BYTES;
    const uint dst_base  = row_idx * p.ne00 + blk_in_row * BLOCK_ELEMS;

#if SUBGROUP_SIZE >= 64
    uvec2 a0 = turbo_bit_address(tid);
    uvec2 a1 = turbo_bit_address(tid + 64u);
    float val0 = turbo_codebook_lookup(turbo_unpack_2bytes(uint(data_a[qs_offset + a0.x]), uint(data_a[qs_offset + a0.x + 1u]), a0.y)) * rcp_inv_std;
    float val1 = turbo_codebook_lookup(turbo_unpack_2bytes(uint(data_a[qs_offset + a1.x]), uint(data_a[qs_offset + a1.x + 1u]), a1.y)) * rcp_inv_std;
    turbo_inverse_rht(val0, val1, tid, norm);
    data_d[dst_base + tid]       = D_TYPE(val0);
    data_d[dst_base + tid + 64u] = D_TYPE(val1);
#else
    uvec2 a0 = turbo_bit_address(tid);
    uvec2 a1 = turbo_bit_address(tid + 32u);
    uvec2 a2 = turbo_bit_address(tid + 64u);
    uvec2 a3 = turbo_bit_address(tid + 96u);
    float v0 = turbo_codebook_lookup(turbo_unpack_2bytes(uint(data_a[qs_offset + a0.x]), uint(data_a[qs_offset + a0.x + 1u]), a0.y)) * rcp_inv_std;
    float v1 = turbo_codebook_lookup(turbo_unpack_2bytes(uint(data_a[qs_offset + a1.x]), uint(data_a[qs_offset + a1.x + 1u]), a1.y)) * rcp_inv_std;
    float v2 = turbo_codebook_lookup(turbo_unpack_2bytes(uint(data_a[qs_offset + a2.x]), uint(data_a[qs_offset + a2.x + 1u]), a2.y)) * rcp_inv_std;
    float v3 = turbo_codebook_lookup(turbo_unpack_2bytes(uint(data_a[qs_offset + a3.x]), uint(data_a[qs_offset + a3.x + 1u]), a3.y)) * rcp_inv_std;
    turbo_inverse_rht(v0, v1, v2, v3, tid, norm);
    data_d[dst_base + tid]       = D_TYPE(v0);
    data_d[dst_base + tid + 32u] = D_TYPE(v1);
    data_d[dst_base + tid + 64u] = D_TYPE(v2);
    data_d[dst_base + tid + 96u] = D_TYPE(v3);
#endif
}
