#version 450

// SET_ROWS: quantize input rows into TURBO_KV_4B blocks in the KV cache.
// Uses standard vk_op_binary_push_constants layout.
// src0 = input data (A_TYPE), src1 = row indices (int), dst = KV cache (TURBO_KV_4B)

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_shader_subgroup_arithmetic : require

#include "types.glsl"
#include "turbo_kv_4b_rht.glsl"

layout (push_constant) uniform parameter {
    uint ne;
    uint ne00; uint ne01; uint ne02; uint ne03;
    uint nb00; uint nb01; uint nb02; uint nb03;
    uint ne10; uint ne11; uint ne12; uint ne13;
    uint nb10; uint nb11; uint nb12; uint nb13;
    uint ne20; uint ne21; uint ne22; uint ne23;
    uint nb20; uint nb21; uint nb22; uint nb23;
    uint misalign_offsets;
    float param1; float param2; int param3;
} p;

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly buffer A {A_TYPE data_a[];};
layout (binding = 1) readonly buffer B {B_TYPE data_b[];};
layout (binding = 2) writeonly buffer D {block_turbo_kv_4b data_d[];};

void main() {
    // Dispatch: one workgroup per block.
    // For set_rows, the dispatch is typically (ne, 1, 1) where ne = total elements.
    // We process one 128-element block per workgroup.
    const uint block_id = gl_WorkGroupID.x;
    const uint src_blocks_per_row = p.ne00 / QUANT_K_TURBO_KV_4B;
    const uint row_in_src = block_id / src_blocks_per_row;
    const uint blk_in_row = block_id % src_blocks_per_row;
    const uint tid = gl_SubgroupInvocationID;

    if (block_id >= p.ne / QUANT_K_TURBO_KV_4B) return;

    // Row mapping: src1 contains destination row indices (I32 or I64)
#if B_SIZE == 64
    const uint dst_row = uint(data_b[row_in_src].x); // uvec2: low 32 bits
#else
    const uint dst_row = data_b[row_in_src];
#endif

    // Read input: src0 is [ne00, ne01, ...] with strides nb0x (in elements)
    const uint src_elem = row_in_src * p.nb01 + blk_in_row * QUANT_K_TURBO_KV_4B;
    float val0 = float(data_a[src_elem + tid]);
    float val1 = float(data_a[src_elem + tid + 64]);

    // Quantize: norm → normalize → forward RHT → inv_std → nearest → pack
    float sum_sq = subgroupAdd(val0 * val0 + val1 * val1);
    float norm = sqrt(sum_sq);
    float rcp_norm = 1.0 / max(norm, 1e-10);
    val0 *= rcp_norm;
    val1 *= rcp_norm;

    turbo_kv_forward_rht(val0, val1, tid);

    float max_abs = subgroupMax(max(abs(val0), abs(val1)));
    float inv_std = 2.7326 / max(max_abs, 1e-10);

    uint idx0 = turbo_kv_nearest(val0 * inv_std);
    uint idx1 = turbo_kv_nearest(val1 * inv_std);

    // Pack indices
    uint partner0 = subgroupShuffleXor(idx0, 1);
    uint partner1 = subgroupShuffleXor(idx1, 1);

    // Write to dst: src0 and dst have same number of elements per row
    const uint dst_blk = dst_row * src_blocks_per_row + blk_in_row;

    if ((tid & 1u) == 0) {
        data_d[dst_blk].mse_indices[tid / 2]       = uint8_t(idx0 | (partner0 << 4));
        data_d[dst_blk].mse_indices[(tid + 64) / 2] = uint8_t(idx1 | (partner1 << 4));
    }
    if (tid == 0) {
        data_d[dst_blk].norm = turbo_kv_f32_to_fp16_bits(norm);
        data_d[dst_blk].inv_std_fp16 = turbo_kv_f32_to_fp16_bits(inv_std);
        data_d[dst_blk].residual_norm = uint16_t(0);
        data_d[dst_blk]._pad = uint16_t(0);
    }
}
