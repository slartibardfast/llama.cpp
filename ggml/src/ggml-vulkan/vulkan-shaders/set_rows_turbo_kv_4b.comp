#version 450

// SET_ROWS for TURBO_KV_4B: stride-based 4D addressing with subgroup-cooperative
// forward FWHT + codebook quantize. Uses the same push_constant layout as
// vk_op_binary_push_constants for full stride and offset support.

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_shader_subgroup_arithmetic : require

#include "types.glsl"
#include "turbo_kv_4b_rht.glsl"

layout (push_constant) uniform parameter {
    uint ne;
    uint ne00; uint ne01; uint ne02; uint ne03;
    uint nb00; uint nb01; uint nb02; uint nb03;
    uint ne10; uint ne11; uint ne12; uint ne13;
    uint nb10; uint nb11; uint nb12; uint nb13;
    uint ne20; uint ne21; uint ne22; uint ne23;
    uint nb20; uint nb21; uint nb22; uint nb23;
    uint misalign_offsets;
    float param1; float param2; int param3;
} p;

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly buffer A {float data_a[];};
#if B_SIZE == 64
layout (binding = 1) readonly buffer B {uvec2 data_b[];};
#else
layout (binding = 1) readonly buffer B {uint data_b[];};
#endif
layout (binding = 2) writeonly buffer D {block_turbo_kv_4b data_d[];};

uint get_aoffset() { return p.misalign_offsets >> 16; }
uint get_boffset() { return (p.misalign_offsets >> 8) & 0xFF; }
uint get_doffset() { return p.misalign_offsets & 0xFF; }

void main() {
    // One workgroup per 128-element TURBO_KV_4B block
    const uint wg = gl_WorkGroupID.z * 262144 + gl_WorkGroupID.y * 512 + gl_WorkGroupID.x;
    const uint flat_elem = wg * QUANT_K_TURBO_KV_4B;
    if (flat_elem >= p.ne) return;

    // Decompose flat element index into 4D source indices
    uint i03 = flat_elem / (p.ne02 * p.ne01 * p.ne00);
    uint rem = flat_elem - i03 * (p.ne02 * p.ne01 * p.ne00);
    uint i02 = rem / (p.ne01 * p.ne00);
    rem -= i02 * (p.ne01 * p.ne00);
    uint i01 = rem / p.ne00;
    uint i00 = rem - i01 * p.ne00;

    // Map source dims to index tensor dims (with repeat/broadcast)
    uint i10 = i01;
    uint i11 = i02 % p.ne11;
    uint i12 = i03 % p.ne12;

    // Look up destination row from index tensor (stride-based + buffer offset)
    uint b_idx = i12 * p.nb12 + i11 * p.nb11 + i10 * p.nb10 + get_boffset();
#if B_SIZE == 64
    uint dst_row = data_b[b_idx].x;
#else
    uint dst_row = data_b[b_idx];
#endif

    // Source address using strides (+ buffer offset)
    uint src_base = i03 * p.nb03 + i02 * p.nb02 + i01 * p.nb01 + i00 * p.nb00 + get_aoffset();

    // Destination block address using strides (+ buffer offset)
    uint dst_blk = i03 * p.nb23 + i02 * p.nb22 + dst_row * p.nb21
                 + (i00 / QUANT_K_TURBO_KV_4B) * p.nb20 + get_doffset();

    uint tid = gl_SubgroupInvocationID;

    // Read source data (64 threads x 2 elements = 128-element block)
    float val0 = data_a[src_base + tid];
    float val1 = data_a[src_base + tid + 64];

    // Forward RHT + codebook quantize (identical to cpy_f32_turbo_kv_4b)
    float sum_sq = subgroupAdd(val0 * val0 + val1 * val1);
    float norm = sqrt(sum_sq);
    float rcp_norm = 1.0 / max(norm, 1e-10);
    val0 *= rcp_norm;
    val1 *= rcp_norm;

    turbo_kv_forward_rht(val0, val1, tid);

    float max_abs = subgroupMax(max(abs(val0), abs(val1)));
    float inv_std = 2.7326 / max(max_abs, 1e-10);

    uint idx0 = turbo_kv_nearest(val0 * inv_std);
    uint idx1 = turbo_kv_nearest(val1 * inv_std);

    uint p0 = subgroupShuffleXor(idx0, 1);
    uint p1 = subgroupShuffleXor(idx1, 1);

    if ((tid & 1u) == 0) {
        data_d[dst_blk].mse_indices[tid / 2]       = uint8_t(idx0 | (p0 << 4));
        data_d[dst_blk].mse_indices[(tid + 64) / 2] = uint8_t(idx1 | (p1 << 4));
    }
    if (tid == 0) {
        data_d[dst_blk].norm    = norm;
        data_d[dst_blk].inv_std = inv_std;
    }
}
