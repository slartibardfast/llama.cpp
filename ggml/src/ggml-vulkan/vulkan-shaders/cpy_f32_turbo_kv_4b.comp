#version 450

// Quantize F32 → TURBO_KV_4B: normalize → forward RHT → codebook nearest → pack.
// Subgroup-size-portable: 128-thread workgroup, one value per lane, works on
// any sg in {32, 64}. See turbo_kv_4b_rht.glsl header for details.

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_shader_subgroup_arithmetic : require

#include "types.glsl"
#include "turbo_kv_4b_rht.glsl"

layout (push_constant) uniform parameter {
    uint ne;
    uint ne00; uint ne01; uint ne02; uint ne03;
    uint nb00; uint nb01; uint nb02; uint nb03;
    uint ne10; uint ne11; uint ne12; uint ne13;
    uint nb10; uint nb11; uint nb12; uint nb13;
    uint misalign_offsets;
    float param1; float param2;
    uint ne0_012mp; uint ne0_012L;
    uint ne0_01mp;  uint ne0_01L;
    uint ne0_0mp;   uint ne0_0L;
    uint ne1_012mp; uint ne1_012L;
    uint ne1_01mp;  uint ne1_01L;
    uint ne1_0mp;   uint ne1_0L;
} p;

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly buffer A {float data_a[];};
layout (binding = 1) writeonly buffer D {block_turbo_kv_4b data_b[];};

void main() {
    const uint block_id = gl_WorkGroupID.z * gl_NumWorkGroups.y * gl_NumWorkGroups.x
                        + gl_WorkGroupID.y * gl_NumWorkGroups.x
                        + gl_WorkGroupID.x;
    if (block_id >= p.ne / QUANT_K_TURBO_KV_4B) return;

    const uint tid = gl_LocalInvocationID.x;
    const uint base = block_id * QUANT_K_TURBO_KV_4B;

    float val = data_a[base + tid];

    // Normalize by L2 norm of the 128-element block.
    float sum_sq = turbo_kv_workgroup_sum(val * val);
    float norm = sqrt(sum_sq);
    float rcp_norm = 1.0 / max(norm, 1e-10);
    val *= rcp_norm;

    turbo_kv_forward_rht(val, tid);

    float max_abs = turbo_kv_workgroup_max(abs(val));
    float inv_std = 2.7326 / max(max_abs, 1e-10);

    uint idx = turbo_kv_nearest(val * inv_std);

    // Pack pairs of 4-bit indices into bytes. Stride 1 is always intra-subgroup.
    uint partner = subgroupShuffleXor(idx, 1);
    if ((tid & 1u) == 0) {
        data_b[block_id].mse_indices[tid / 2] = uint8_t(idx | (partner << 4));
    }
    if (tid == 0) {
        data_b[block_id].norm    = norm;
        data_b[block_id].inv_std = inv_std;
    }
}
