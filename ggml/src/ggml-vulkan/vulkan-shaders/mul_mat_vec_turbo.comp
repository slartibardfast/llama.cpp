// mul_mat_vec_turbo.comp — Fused RHT-space mul_mat_vec for TURBO_*B weight types
//
// Compile with: -DBITS=2|3|4|5 -DSUBGROUP_SIZE=32|64
//
// Multi-column support: NUM_COLS subgroups per workgroup, each handles one
// (row, column) pair. Workgroup size = SUBGROUP_SIZE * NUM_COLS.
// Spec constants: 0=BLOCK_SIZE, 1=NUM_ROWS(always 1), 2=NUM_COLS.

#version 450

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_shader_subgroup_arithmetic : require

#include "turbo_rht.glsl"

#define BLOCK_ELEMS 128
#define HEADER_BYTES 4
#define DATA_BYTES (BLOCK_ELEMS * BITS / 8)
#define BLOCK_BYTES (HEADER_BYTES + DATA_BYTES)

layout (constant_id = 0) const uint BLOCK_SIZE = 64;   // workgroup size
layout (constant_id = 1) const uint NUM_ROWS = 1;       // always 1 for TURBO
layout (constant_id = 2) const uint NUM_COLS = 1;        // columns per workgroup

// Push constants matching vk_mat_vec_push_constants
layout (push_constant) uniform parameter {
    uint ncols;
    uint stride_a;
    uint stride_b;
    uint stride_d;
    uint batch_stride_a;
    uint batch_stride_b;
    uint batch_stride_d;
    uint fusion_flags;
    uint base_work_group_y;
    uint ne02;
    uint ne12;
    uint broadcast2;
    uint broadcast3;
} p;

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly buffer A { uint8_t data_a[]; };  // quantized weights
layout (binding = 1) readonly buffer B { float   data_b[]; };  // f32 activation
layout (binding = 2) writeonly buffer D { float   data_d[]; }; // f32 output
layout (binding = 3) readonly buffer Fuse0 { float data_fuse0[]; }; // unused, required by dispatch
layout (binding = 4) readonly buffer Fuse1 { float data_fuse1[]; }; // unused, required by dispatch

void main() {
    const uint tid = gl_SubgroupInvocationID;

    // Column index: which subgroup within the workgroup
    const uint col = gl_SubgroupID;
    if (col >= NUM_COLS) return;

    // Row index — standard pattern: WorkGroupID.x carries rows, z for overflow
    const uint row = NUM_ROWS * (gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z);
    if (row >= p.stride_d) return; // stride_d = ne01 = number of rows

    // Batch index from WorkGroupID.y
    const uint batch_idx = gl_WorkGroupID.y + p.base_work_group_y;

    // Batch offset for A (weights): push constants give strides in elements,
    // but data_a is byte-addressed. Convert using block geometry.
    uint batch_idx_a = 0u;
    if (batch_idx != 0u) {
        uint i13 = batch_idx / p.ne12;
        uint i12 = batch_idx % p.ne12;
        uint i03 = i13 / p.broadcast3;
        uint i02 = i12 / p.broadcast2;
        batch_idx_a = i03 * p.ne02 + i02;
    }

    // a_offset in bytes: batch_stride_a is in elements, convert to blocks then bytes
    const uint a_batch_offset = batch_idx_a * (p.batch_stride_a / BLOCK_ELEMS) * BLOCK_BYTES;
    const uint bytes_per_row = (p.ncols / BLOCK_ELEMS) * BLOCK_BYTES;
    const uint a_offset = row * bytes_per_row + a_batch_offset;

    // B offset (f32 elements) — column and batch
    const uint b_offset = col * p.stride_b + batch_idx * p.batch_stride_b;

    // D output index
    const uint d_idx = row + col * p.stride_d + batch_idx * p.batch_stride_d;

    const uint n_blocks = p.ncols / BLOCK_ELEMS;
    float row_acc = 0.0;

    for (uint blk = 0; blk < n_blocks; blk++) {
        const uint elem_base = blk * BLOCK_ELEMS;
        const uint blk_byte_offset = a_offset + blk * BLOCK_BYTES;

        // Read block header
        uint16_t norm_bits    = uint16_t(data_a[blk_byte_offset + 0]) | (uint16_t(data_a[blk_byte_offset + 1]) << 8);
        uint16_t inv_std_bits = uint16_t(data_a[blk_byte_offset + 2]) | (uint16_t(data_a[blk_byte_offset + 3]) << 8);
        float norm    = turbo_fp16_to_f32(norm_bits);
        float inv_std = turbo_fp16_to_f32(inv_std_bits);
        float rcp_inv_std = 1.0 / max(inv_std, 1e-10);

        const uint qs_offset = blk_byte_offset + HEADER_BYTES;

#if SUBGROUP_SIZE >= 64
        // Wave64: each thread handles 2 elements [tid, tid+64]
        float act0 = data_b[b_offset + elem_base + tid];
        float act1 = data_b[b_offset + elem_base + tid + 64u];
        turbo_forward_rht(act0, act1, tid);

        uvec2 a0 = turbo_bit_address(tid);
        uvec2 a1 = turbo_bit_address(tid + 64u);
        float w0 = turbo_codebook_lookup(turbo_unpack_2bytes(uint(data_a[qs_offset + a0.x]), uint(data_a[qs_offset + a0.x + 1u]), a0.y)) * rcp_inv_std;
        float w1 = turbo_codebook_lookup(turbo_unpack_2bytes(uint(data_a[qs_offset + a1.x]), uint(data_a[qs_offset + a1.x + 1u]), a1.y)) * rcp_inv_std;

        float local_dot = w0 * act0 + w1 * act1;
        float block_dot = subgroupAdd(local_dot);
        row_acc += block_dot * norm;
#else
        // Wave32: each thread handles 4 elements [tid, tid+32, tid+64, tid+96]
        float act0 = data_b[b_offset + elem_base + tid];
        float act1 = data_b[b_offset + elem_base + tid + 32u];
        float act2 = data_b[b_offset + elem_base + tid + 64u];
        float act3 = data_b[b_offset + elem_base + tid + 96u];
        turbo_forward_rht(act0, act1, act2, act3, tid);

        uvec2 a0 = turbo_bit_address(tid);
        uvec2 a1 = turbo_bit_address(tid + 32u);
        uvec2 a2 = turbo_bit_address(tid + 64u);
        uvec2 a3 = turbo_bit_address(tid + 96u);
        float w0 = turbo_codebook_lookup(turbo_unpack_2bytes(uint(data_a[qs_offset + a0.x]), uint(data_a[qs_offset + a0.x + 1u]), a0.y)) * rcp_inv_std;
        float w1 = turbo_codebook_lookup(turbo_unpack_2bytes(uint(data_a[qs_offset + a1.x]), uint(data_a[qs_offset + a1.x + 1u]), a1.y)) * rcp_inv_std;
        float w2 = turbo_codebook_lookup(turbo_unpack_2bytes(uint(data_a[qs_offset + a2.x]), uint(data_a[qs_offset + a2.x + 1u]), a2.y)) * rcp_inv_std;
        float w3 = turbo_codebook_lookup(turbo_unpack_2bytes(uint(data_a[qs_offset + a3.x]), uint(data_a[qs_offset + a3.x + 1u]), a3.y)) * rcp_inv_std;

        float local_dot = w0 * act0 + w1 * act1 + w2 * act2 + w3 * act3;
        float block_dot = subgroupAdd(local_dot);
        row_acc += block_dot * norm;
#endif
    }

    // Thread 0 of each subgroup writes its column's output
    if (tid == 0u) {
        data_d[d_idx] = row_acc;
    }
}
