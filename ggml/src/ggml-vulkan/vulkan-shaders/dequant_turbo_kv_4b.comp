#version 450

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require

#include "types.glsl"
#include "turbo_kv_4b_rht.glsl"

layout (push_constant) uniform parameter {
    uint ne;
    uint ne00; uint ne01; uint ne02; uint ne03;
    uint nb00; uint nb01; uint nb02; uint nb03;
    uint ne10; uint ne11; uint ne12; uint ne13;
    uint nb10; uint nb11; uint nb12; uint nb13;
    uint misalign_offsets;
    float param1; float param2;
    uint ne0_012mp; uint ne0_012L;
    uint ne0_01mp;  uint ne0_01L;
    uint ne0_0mp;   uint ne0_0L;
    uint ne1_012mp; uint ne1_012L;
    uint ne1_01mp;  uint ne1_01L;
    uint ne1_0mp;   uint ne1_0L;
} p;

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly buffer A {block_turbo_kv_4b data_a[];};
layout (binding = 1) writeonly buffer D {D_TYPE data_b[];};

void main() {
    // Reconstruct flat block ID from 3D dispatch grid (grid capped at 512 per dim)
    const uint block_id = gl_WorkGroupID.z * gl_NumWorkGroups.y * gl_NumWorkGroups.x
                        + gl_WorkGroupID.y * gl_NumWorkGroups.x
                        + gl_WorkGroupID.x;
    if (block_id >= p.ne / QUANT_K_TURBO_KV_4B) return;

    const uint tid = gl_SubgroupInvocationID;
    const float norm = unpackHalf2x16(uint(data_a[block_id].norm)).x;
    const float inv_std = unpackHalf2x16(uint(data_a[block_id].inv_std_fp16)).x;
    const float rcp_inv_std = 1.0 / max(inv_std, 1e-10);

    float val0 = turbo_kv_unpack_byte(uint(data_a[block_id].mse_indices[tid / 2]),      tid,      rcp_inv_std);
    float val1 = turbo_kv_unpack_byte(uint(data_a[block_id].mse_indices[(tid + 64) / 2]), tid + 64, rcp_inv_std);

    turbo_kv_inverse_rht(val0, val1, tid, norm);

    const uint base = block_id * QUANT_K_TURBO_KV_4B;
    data_b[base + tid]      = D_TYPE(val0);
    data_b[base + tid + 64] = D_TYPE(val1);
}
