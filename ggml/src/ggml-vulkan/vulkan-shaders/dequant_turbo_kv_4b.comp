#version 450

// Dequantize TURBO_KV_4B → D_TYPE: unpack 4-bit indices → codebook lookup →
// inverse RHT. Subgroup-size-portable: 128-thread workgroup, one element per
// lane. See turbo_kv_4b_rht.glsl header.

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_shader_subgroup_arithmetic : require

#include "types.glsl"
#include "turbo_kv_4b_rht.glsl"

layout (push_constant) uniform parameter {
    uint ne;
    uint ne00; uint ne01; uint ne02; uint ne03;
    uint nb00; uint nb01; uint nb02; uint nb03;
    uint ne10; uint ne11; uint ne12; uint ne13;
    uint nb10; uint nb11; uint nb12; uint nb13;
    uint misalign_offsets;
    float param1; float param2;
    uint ne0_012mp; uint ne0_012L;
    uint ne0_01mp;  uint ne0_01L;
    uint ne0_0mp;   uint ne0_0L;
    uint ne1_012mp; uint ne1_012L;
    uint ne1_01mp;  uint ne1_01L;
    uint ne1_0mp;   uint ne1_0L;
} p;

layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly buffer A {block_turbo_kv_4b data_a[];};
layout (binding = 1) writeonly buffer D {D_TYPE data_b[];};

void main() {
    const uint block_id = gl_WorkGroupID.z * gl_NumWorkGroups.y * gl_NumWorkGroups.x
                        + gl_WorkGroupID.y * gl_NumWorkGroups.x
                        + gl_WorkGroupID.x;
    if (block_id >= p.ne / QUANT_K_TURBO_KV_4B) return;

    const uint tid = gl_LocalInvocationID.x;
    const float norm    = data_a[block_id].norm;
    const float inv_std = data_a[block_id].inv_std;
    const float rcp_inv_std = 1.0 / max(inv_std, 1e-10);

    float val = turbo_kv_unpack_byte(uint(data_a[block_id].mse_indices[tid / 2]), tid, rcp_inv_std);

    turbo_kv_inverse_rht(val, tid, norm);

    const uint base = block_id * QUANT_K_TURBO_KV_4B;
    data_b[base + tid] = D_TYPE(val);
}
